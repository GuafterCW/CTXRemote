{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CTXRemote",
  "version": "0.1.0",
  "identifier": "info.philipp-dev.ctxremote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CTXRemote",
        "width": 940,
        "height": 600,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer.nsh"
      }
    },
    "category": "Utility",
    "shortDescription": "Fernzugriff auf eigene Geräte",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
